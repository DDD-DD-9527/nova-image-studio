# Set these in Zeabur service environment variables; do not upload local .env.
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
NOVA_TASK_DB=/data/nova-tasks.sqlite
NOVA_IMAGE_DIR=/data/nova-images
NOVA_PLUGIN_MEDIA_DIR=/data/plugin-media
NOVA_CDP_ENABLED=false
TZ=Asia/Shanghai
PROMPT_GALLERY_MODE=1
# For video plugins with reference media, set your public Zeabur HTTPS URL:
# NOVA_PUBLIC_BASE_URL=https://your-service.zeabur.app
